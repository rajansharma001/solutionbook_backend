# =================================================================
# SikshyaHub Backend - Production Environment Configuration Template
# =================================================================

# Server & Runtime
PORT=3000
NODE_ENV=production

# Database (PostgreSQL)
# In production, use managed PostgreSQL with connection pooling & SSL:
# e.g., postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sikshyahub?schema=public"

# Authentication & Security
# Generate a secure 64-character hex secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_64_CHAR_HEX_SECRET_IN_PRODUCTION"
JWT_EXPIRES_IN="7d"

# Frontend & CORS
# In production, set to your verified production domain e.g. https://sikshyahub.com
FRONTEND_URL="http://localhost:3001"

# Email Delivery (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-notification-email@gmail.com"
SMTP_PASS="your-smtp-app-password"

# AI Assistant Integration (Google Gemini)
GEMINI_API_KEY="your-gemini-api-key"

# Cache & Real-Time (Redis)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Media & Storage
STORAGE_PROVIDER="local" # "local" | "s3"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="sikshyahub-assets"
